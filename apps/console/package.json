{
  "name": "@hybrid-billing/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1 --port 8787 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/app/assemble.test.ts src/shared/review-store.test.ts src/modules/sources/api.test.ts src/modules/operations/index.test.ts src/modules/onboarding/store.test.ts src/modules/operations/pages/overview/model.test.ts src/modules/operations/pages/core-index-close/model.test.ts",
    "qa": "node tools/browser-qa.mjs",
    "qa:work": "node tools/work-qa.mjs",
    "qa:entry": "node tools/entry-qa.mjs",
    "qa:setup": "node tools/setup-qa.mjs",
    "qa:overview": "node tools/overview-qa.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "tsx": "4.23.15",
    "@types/node": "22.19.0"
  }
}
