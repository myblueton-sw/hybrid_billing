<clickhouse>
    <profiles>
        <hb_locked>
            <join_use_nulls>1</join_use_nulls>
            <input_format_null_as_default>0</input_format_null_as_default>
            <input_format_csv_empty_as_default>0</input_format_csv_empty_as_default>
            <input_format_parquet_allow_missing_columns>0</input_format_parquet_allow_missing_columns>
            <serialize_query_plan>0</serialize_query_plan>
            <lightweight_deletes_sync>2</lightweight_deletes_sync>
            <constraints>
                <join_use_nulls><const/></join_use_nulls>
                <input_format_null_as_default><const/></input_format_null_as_default>
                <input_format_csv_empty_as_default><const/></input_format_csv_empty_as_default>
                <input_format_parquet_allow_missing_columns><const/></input_format_parquet_allow_missing_columns>
                <serialize_query_plan><const/></serialize_query_plan>
            </constraints>
        </hb_locked>
    </profiles>
    <users>
        <default remove="remove"/>
        <probe_admin>
            <password from_env="CH_ADMIN_PASSWORD"/>
            <networks><ip>::/0</ip></networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
            <show_named_collections>1</show_named_collections>
            <show_named_collections_secrets>0</show_named_collections_secrets>
        </probe_admin>
    </users>
</clickhouse>
